{
  "name": "@vellum/cli",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vellum": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vellum/core": "workspace:*",
    "@vellum/adapter-w3c": "workspace:*",
    "@vellum/adapter-shadcn": "workspace:*",
    "@vellum/adapter-md": "workspace:*",
    "fast-glob": "^3.3.2"
  }
}
