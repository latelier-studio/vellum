{
  "name": "@vellum/story",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "import": "./dist/props.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/props.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-docgen-typescript": "^2.2.2",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react-docgen-typescript": { "optional": true },
    "typescript": { "optional": true }
  }
}
