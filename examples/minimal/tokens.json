{
  "color": {
    "bg":         { "$value": "#ffffff", "$type": "color" },
    "fg":         { "$value": "#0a0a0a", "$type": "color" },
    "border":     { "$value": "#e5e5e5", "$type": "color" },
    "muted":      { "$value": "#f5f5f5", "$type": "color" },
    "muted-fg":   { "$value": "#737373", "$type": "color" },
    "accent":     { "$value": "#000000", "$type": "color" },
    "accent-fg":  { "$value": "#ffffff", "$type": "color" }
  },
  "radius": {
    "md": { "$value": "6px", "$type": "dimension" }
  },
  "type": {
    "display": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
    "scale":   { "$value": "major-third",                  "$type": "typography" }
  }
}
